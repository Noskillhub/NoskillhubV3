-- UI Logic & Animations
local isOpen = true
minimizeBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    local targetSize = isOpen and UDim2.new(0, 300, 0, 190) or UDim2.new(0, 300, 0, 40)
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    TweenService:Create(mainFrame, tweenInfo, {Size = targetSize}):Play()
    minimizeBtn.Text = isOpen and "-" or "+"
end)

speedInput.FocusLost:Connect(function()
    local val = tonumber(speedInput.Text)
    if val then
        speedValue = val
    else
        speedValue = 0
        speedInput.Text = ""
    end
end)

toggleBtn.MouseButton1Click:Connect(function()
    isToggled = not isToggled
    if isToggled then
        toggleBtn.Text = "Toggle Speed: ON"
        TweenService:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(40, 200, 40)}):Play()
    else
        toggleBtn.Text = "Toggle Speed: OFF"
        TweenService:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = accentRed}):Play()
    end
end)

-- Dragging Logic
local dragging, dragInput, dragStart, startPos
topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Core CFrame Logic
RunService.RenderStepped:Connect(function(deltaTime)
    if not isToggled or speedValue <= 0 then return end
    
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    
    if humanoid and hrp and humanoid.Health > 0 then
        if humanoid.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * (speedValue * deltaTime))
        end
    end
end)
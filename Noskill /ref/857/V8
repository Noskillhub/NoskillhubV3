task.spawn(function()
    local frameRenderIteration = 0
    local samplingTimeframe = tick()
    local calculatedFPS = 60
    local lastTrackedPosition = Vector3.new(0,0,0)
    local calculatedVelocity = 0
    
    RunService.RenderStepped:Connect(function(dt)
        frameRenderIteration = frameRenderIteration + 1
        if tick() - samplingTimeframe >= 0.5 then
            calculatedFPS = math.floor(frameRenderIteration / (tick() - samplingTimeframe))
            frameRenderIteration = 0
            samplingTimeframe = tick()
        end
        
        local characterModel = player.Character
        local hrpComponent = characterModel and characterModel:FindFirstChild("HumanoidRootPart")
        
        if hrpComponent and characterModel:FindFirstChild("Head") then
            BillboardGui.Adornee = characterModel.Head
            BillboardGui.StudsOffset = Vector3.new(0, 3.5, 0)
            local currentPosition = hrpComponent.Position
            if lastTrackedPosition ~= Vector3.new(0,0,0) and dt > 0 then
                local distanceMoved = (currentPosition - lastTrackedPosition).Magnitude
                calculatedVelocity = math.floor(distanceMoved / dt)
            end
            lastTrackedPosition = currentPosition
            if calculatedVelocity > 1500 then calculatedVelocity = 0 end
            MetricsCard.Text = "⚡ NOSKILL HUB METRICS\nFPS: " .. calculatedFPS .. " | VEL: " .. calculatedVelocity .. " studs/sec"
        else
            BillboardGui.Adornee = nil
            lastTrackedPosition = Vector3.new(0,0,0)
            calculatedVelocity = 0
        end
    end)
end)


local chromaHueRegistry = 0
RunService.RenderStepped:Connect(function()
    chromaHueRegistry = chromaHueRegistry + 0.004
    if chromaHueRegistry > 1 then chromaHueRegistry = 0 end
    local currentChromaRGB = Color3.fromHSV(chromaHueRegistry, 0.9, 1)
    
    if _G.NS_SETTINGS.UIVisible then
        FOVCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        FOVCircle.Radius = _G.NS_SETTINGS.FOV
        FOVCircle.Color = currentChromaRGB
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end
    
    pcall(ManageSkyTethers)
    pcall(ManageRedESP)
    
    local optimalTarget = nil
    local minimumDistance = _G.NS_SETTINGS.FOV
    
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer ~= player and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
            local head = targetPlayer.Character.Head
            local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
                local dist = (Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if IsVisible(head) and dist < minimumDistance then
                    minimumDistance = dist
                    optimalTarget = targetPlayer
                end
            end
        end
    end
    
    CurrentSelectedTarget = optimalTarget
    
    if optimalTarget and _G.NS_SETTINGS.Locking then
        local destinationHead = optimalTarget.Character.Head
        local computedTargetCFrame = CFrame.lookAt(camera.CFrame.Position, destinationHead.Position)
        local smoothFactor = math.clamp(_G.NS_SETTINGS.Smoothness / 10, 0.05, 1)
        camera.CFrame = camera.CFrame:Lerp(computedTargetCFrame, smoothFactor)
        
        if _G.NS_SETTINGS.HardLock and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = destinationHead.CFrame * CFrame.new(0, 0, 2.5)
        end
    end
end)

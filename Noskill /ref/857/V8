local function ManageSkyTethers()
    if not _G.NS_SETTINGS.DoubleTether then
        for _, obj in pairs(PillarBeamArray) do
            obj.L1.Visible = false; obj.L2.Visible = false
        end
        return
    end
    
    local coreCharacter = player.Character
    local coreHRP = coreCharacter and coreCharacter:FindFirstChild("HumanoidRootPart")
    local coreHead = coreCharacter and coreCharacter:FindFirstChild("Head")
    if not coreHRP or not coreHead then return end
    
    local skyWorldOrigin = coreHRP.Position + Vector3.new(0, 400, 0)
    local skyScreenPos, skyOnScreen = camera:WorldToViewportPoint(skyWorldOrigin)
    local headScreenPos, headOnScreen = camera:WorldToViewportPoint(coreHead.Position)
    
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer ~= player and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
            local tHead = targetPlayer.Character.Head
            local tHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if tHum and tHum.Health > 0 then
                if not PillarBeamArray[targetPlayer] then
                    PillarBeamArray[targetPlayer] = {L1 = Drawing.new("Line"), L2 = Drawing.new("Line")}
                end
                
                local elements = PillarBeamArray[targetPlayer]
                local targetScreenPos, targetOnScreen = camera:WorldToViewportPoint(tHead.Position)
                
                if skyOnScreen and headOnScreen then
                    elements.L1.From = Vector2.new(headScreenPos.X, headScreenPos.Y)
                    elements.L1.To = Vector2.new(skyScreenPos.X, skyScreenPos.Y)
                    elements.L1.Color = Color3.fromRGB(255, 0, 0)
                    elements.L1.Thickness = 1.5
                    elements.L1.Visible = _G.NS_SETTINGS.UIVisible
                else
                    elements.L1.Visible = false
                end
                
                if skyOnScreen and targetOnScreen then
                    elements.L2.From = Vector2.new(skyScreenPos.X, skyScreenPos.Y)
                    elements.L2.To = Vector2.new(targetScreenPos.X, targetScreenPos.Y)
                    elements.L2.Color = Color3.fromRGB(255, 0, 0)
                    elements.L2.Thickness = 1.2
                    elements.L2.Visible = _G.NS_SETTINGS.UIVisible
                else
                    elements.L2.Visible = false
                end
            else
                if PillarBeamArray[targetPlayer] then
                    PillarBeamArray[targetPlayer].L1.Visible = false
                    PillarBeamArray[targetPlayer].L2.Visible = false
                end
            end
        end
    end
end


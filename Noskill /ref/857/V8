                appendKey = " [" .. Keybinds[setting].Name .. "]"
            end
        end
        
        Btn.Text = "   " .. name .. appendKey
        Btn.TextColor3 = enabled and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 255, 255)
        Btn.UIStroke.Color = enabled and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(255, 255, 255)
    end)
end

local function CreateSlider(name, min, max, setting)
    local SliderFrame = Instance.new("Frame", Container)
    SliderFrame.Size, SliderFrame.BackgroundTransparency = UDim2.new(1, -10, 0, 45), 1
    
    local Label = Instance.new("TextButton", SliderFrame)
    Label.Size, Label.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    Label.Text, Label.TextColor3, Label.Font, Label.TextSize = "", Color3.new(1,1,1), Enum.Font.Gotham, 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    local Background = Instance.new("Frame", SliderFrame)
    Background.Size, Background.Position = UDim2.new(1, -20, 0, 5), UDim2.new(0, 10, 0, 30)
    ApplyLiquidGlass(Background, 0.2, 0.5)
    
    local Fill = Instance.new("Frame", Background)
    Fill.Size = UDim2.new(0, 0, 1, 0)
    ApplyLiquidGlass(Fill, 0.1, 0.1)
    Fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    
    local dragging = false
    local function Update(input)
        local delta = math.clamp((input.Position.X - Background.AbsolutePosition.X) / Background.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * delta
        if setting == "GravityValue" then
            _G.NS_SETTINGS[setting] = math.round(val * 10) / 10
        else
            _G.NS_SETTINGS[setting] = math.floor(val)
        end
    end
    
    Label.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; Update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end
    end)
    
    RunService.RenderStepped:Connect(function()
        local currentVal = _G.NS_SETTINGS[setting]
        Label.Text = "   " .. name .. ": " .. tostring(currentVal)
        Fill.Size = UDim2.new((currentVal - min) / (max - min), 0, 1, 0)
    end)
end

